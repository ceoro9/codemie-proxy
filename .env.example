# ── Required ───────────────────────────────────────────────────────────────
CODEMIE_ASSISTANT_SLUG=codemie-litellm-proxy

# ── Models ────────────────────────────────────────────────────────────────
# Comma-separated list of model IDs exposed on /v1/models.
# Each entry is "modelId" or "modelId:assistantSlug" (slug defaults to CODEMIE_ASSISTANT_SLUG).
# Example: CODEMIE_MODELS=claude-opus-4-7,claude-sonnet-4-6:my-sonnet-slug
# Default: single entry using CODEMIE_ASSISTANT_SLUG as both model ID and slug.
CODEMIE_MODELS=codemie-litellm-proxy

# ── Server (defaults shown) ────────────────────────────────────────────────
# CODEMIE_SERVER_URL=https://codemie.lab.epam.com/code-assistant-api

# ── Auth mode ─────────────────────────────────────────────────────────────
# sso      — browser redirect, uses session cookies (default, recommended)
# password — Keycloak ROPC (username + password)
# client   — Keycloak client_credentials (service accounts / CI)
CODEMIE_AUTH_TYPE=sso

# ── SSO: no extra vars needed ─────────────────────────────────────────────
# A browser window opens on first request; cookies are cached in
# ~/.codemie-proxy-auth.json (chmod 600).

# ── Password mode ─────────────────────────────────────────────────────────
# CODEMIE_AUTH_TYPE=password
# CODEMIE_USERNAME=you@epam.com
# CODEMIE_PASSWORD=

# ── Client credentials mode ───────────────────────────────────────────────
# CODEMIE_AUTH_TYPE=client
# CODEMIE_CLIENT_ID=codemie-sdk
# CODEMIE_CLIENT_SECRET=

# ── Keycloak (defaults match EPAM prod) ───────────────────────────────────
# CODEMIE_KEYCLOAK_URL=https://keycloak.eks-core.aws.main.edp.projects.epam.com/auth
# CODEMIE_REALM=codemie-prod

# ── Proxy ─────────────────────────────────────────────────────────────────
# PORT=9090
# CODEMIE_AUTH_CACHE=~/.codemie-proxy-auth.json

# ── SSO in Docker ──────────────────────────────────────────────────────────
# Bind the SSO callback server to a fixed port instead of a random one.
# Required when running in Docker with SSO: publish this port so the browser
# redirect (localhost:<port>?token=...) can reach the container.
#   docker run -p 9090:9090 -p 9091:9091 -e CODEMIE_SSO_CALLBACK_PORT=9091 ...
# CODEMIE_SSO_CALLBACK_PORT=9091
